# --- keys -------------------------------------------------------------------
# Primary LLM: console.groq.com/keys  (starts gsk_)
GROQ_API_KEY=

# Backup LLM: aistudio.google.com/apikey  (use a PERSONAL Google account -
# Workspace/education projects return 403 PERMISSION_DENIED)
GEMINI_API_KEY=

# --- optional tuning (defaults shown) ---------------------------------------
# EMBED_PROFILE=english        # or: multilingual
# TOP_K=5                      # chunks fed to the model
# CHUNK_CHARS=900
# CHUNK_OVERLAP=150
# MIN_SIMILARITY=0.18          # below this, refuse instead of guessing
# MMR_LAMBDA=0.5               # 1.0 = pure relevance, 0.0 = pure diversity
# USE_HYBRID=1                 # 0 disables BM25, leaving vector search only
# GROQ_MODEL=openai/gpt-oss-120b
# TEMPERATURE=0.1
# OCR_LANG=eng                 # e.g. eng+hin for Hindi scans
